rules_version = '2';

// Blind relay for the Grove. Clients store only AES-GCM ciphertext at a random
// 128-bit mailbox path. No auth, no names, no plain text.
service cloud.firestore {
  match /databases/{database}/documents {

    match /boxes/{box}/msgs/{msg} {
      // Read only when you already know the mailbox id (32 hex chars).
      allow get, list: if box.matches('^[0-9a-f]{32}$');

      allow create: if box.matches('^[0-9a-f]{32}$')
        && request.resource.data.keys().hasOnly(['c', 'iv', 't', 'exp'])
        && request.resource.data.keys().hasAll(['c', 'iv', 't', 'exp'])
        && request.resource.data.c is string
        && request.resource.data.c.size() > 0
        && request.resource.data.c.size() < 8192
        && request.resource.data.iv is string
        && request.resource.data.iv.size() == 16
        && request.resource.data.t == request.time
        && request.resource.data.exp is timestamp
        && request.resource.data.exp > request.time
        && request.resource.data.exp < request.time + duration.value(31, 'd');

      allow update, delete: if false;
    }

    // Everything else, including collection-group queries, is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
